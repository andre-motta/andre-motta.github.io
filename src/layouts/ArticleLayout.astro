---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { articlePath, categoryPath, formatDate, isoDate, tagPath } from '../lib/articles';

interface Props {
  article: CollectionEntry<'articles'>;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  related?: CollectionEntry<'articles'>[];
}

const { article, headings = [], related = [] } = Astro.props;
const { data } = article;
const visibleHeadings = headings.filter((heading) => heading.depth <= 3);
---
<BaseLayout title={data.title} description={data.description} canonicalPath={articlePath(article)} noindex={data.draft}>
  <article class="article-shell" data-draft={String(data.draft)}>
    <header class="article-header">
      <p class="meta">
        <a href={categoryPath(data.category)}>{data.category}</a>
        · <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
        {data.readTime ? ` · ${data.readTime}` : ''}
        {data.draft ? ' · Draft' : ''}
      </p>
      <h1 class="article-title">{data.title}</h1>
      <p class="article-summary">{data.description}</p>
    </header>

    <div class="article-layout">
      <div class="prose"><slot /></div>

      {visibleHeadings.length > 0 && (
        <nav class="article-toc" aria-label="On this page">
          <p class="toc-heading">On this page</p>
          <ol>
            {visibleHeadings.map((heading) => (
              <li class={`toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>

    <footer class="article-footer">
      {data.tags.length > 0 && (
        <p class="tag-list" aria-label="Tags">
          {data.tags.map((tag) => <a href={tagPath(tag)}>#{tag}</a>)}
        </p>
      )}
      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 class="related-title" id="related-title">Related writing</h2>
          <ul class="related-list">
            {related.map((entry) => (
              <li><a href={articlePath(entry)}>{entry.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}
      <p><a class="section-link" href="/archives.html">← Back to writing</a></p>
    </footer>
  </article>
</BaseLayout>

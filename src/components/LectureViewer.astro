</style>

<script>
  import {
    createPresenterSession,
    parsePresenterMessage,
    presenterChannelName,
    presenterFragment,
    type PresenterMode,
  } from '../scripts/lecture-presenter-protocol';

  const viewer = document.querySelector<HTMLElement>('[data-lecture-viewer]');

  if (viewer) {
    const slides = Array.from(viewer.querySelectorAll<HTMLElement>('[data-slide]'));
    const total = Number(viewer.dataset.total) || slides.length;
    const previous = viewer.querySelector<HTMLButtonElement>('[data-previous]');
    const next = viewer.querySelector<HTMLButtonElement>('[data-next]');
    const fullscreen = viewer.querySelector<HTMLButtonElement>('[data-fullscreen]');
    const fullscreenLabel = viewer.querySelector<HTMLElement>('[data-fullscreen-label]');
    const numberLabel = viewer.querySelector<HTMLElement>('[data-slide-number]');
    const announcement = viewer.querySelector<HTMLElement>('[data-announcement]');
    const presenterButton = viewer.querySelector<HTMLButtonElement>('[data-presenter]');
    const presenterStatus = viewer.querySelector<HTMLElement>('[data-presenter-status]');
    const presenterStandalone = viewer.querySelector<HTMLAnchorElement>('[data-presenter-standalone]');
    const lectureSlug = viewer.dataset.lectureSlug || 'lecture';
    const presenterUrl = viewer.dataset.presenterUrl || `/talks/${lectureSlug}/presenter.html`;
    const presenterMode = (viewer.dataset.lectureMode === 'web' ? 'web' : 'original') as PresenterMode;
    let current = 1;
    let presenterChannel: BroadcastChannel | null = null;
    let presenterWindow: Window | null = null;
    let presenterSession: string | null = null;
    let presenterStateSequence = 0;
    let presenterCommandSequence = -1;
    let presenterWindowWatch: number | null = null;
    let presenterHeartbeatAt = 0;

    const setPresenterStatus = (message: string) => {
      if (presenterStatus) presenterStatus.textContent = message;
    };

    const updateStandaloneLink = () => {
      if (presenterStandalone) presenterStandalone.href = `${presenterStandalone.pathname}${presenterFragment({ mode: presenterMode, slide: current })}`;
    };

    function broadcastPresenterState(type: 'state' | 'heartbeat' = 'state') {
      if (!presenterChannel || !presenterSession) return;
      presenterStateSequence += 1;
      presenterChannel.postMessage({
        version: 1,
        type,
        session: presenterSession,
        mode: presenterMode,
        slide: current,
        total,
        sequence: presenterStateSequence,
      });
      presenterHeartbeatAt = Date.now();
    }

    function cleanupPresenter(sendEnded: boolean) {
      if (presenterWindowWatch !== null) window.clearInterval(presenterWindowWatch);
      presenterWindowWatch = null;
      if (presenterChannel) {
        if (sendEnded && presenterSession) {
          try {
            presenterChannel.postMessage({ version: 1, type: 'ended', session: presenterSession, mode: presenterMode });
          } catch {
            // The channel may already be unavailable while the page is closing.
          }
        }
        presenterChannel.close();
      }
      presenterChannel = null;
      presenterSession = null;
      presenterWindow = null;
      presenterCommandSequence = -1;
    }

    function openPresenter() {
      updateStandaloneLink();
      if (presenterWindow && !presenterWindow.closed) {
        presenterWindow.focus();
        return;
      }
      cleanupPresenter(false);
      const session = createPresenterSession();
      const canBroadcast = Boolean(session) && typeof BroadcastChannel !== 'undefined';
      if (canBroadcast && session) {
        try {
          presenterSession = session;
          presenterStateSequence = 0;
          presenterCommandSequence = -1;
          presenterChannel = new BroadcastChannel(presenterChannelName(lectureSlug, presenterMode, session));
          presenterChannel.addEventListener('message', (event: MessageEvent<unknown>) => {
            if (!presenterSession || !presenterChannel) return;
            const message = parsePresenterMessage(event.data, { session: presenterSession, mode: presenterMode });
            if (!message) return;
            if (message.type === 'ready') {
              presenterCommandSequence = -1;
              broadcastPresenterState();
              return;
            }
            if (message.type !== 'command' || message.sequence <= presenterCommandSequence) return;
            presenterCommandSequence = message.sequence;
            if (message.command === 'previous') {
              const before = current;
              move(-1);
              if (current === before) broadcastPresenterState();
            } else if (message.command === 'next') {
              const before = current;
              move(1);
              if (current === before) broadcastPresenterState();
            } else if (message.command === 'first') {
              setSlide(1, true);
            } else if (message.command === 'last') {
              setSlide(total, true);
            } else if (typeof message.slide === 'number') {
              setSlide(message.slide, true);
            }
          });
          const popupUrl = `${window.location.origin}${presenterUrl}${presenterFragment({ session, mode: presenterMode, slide: current })}`;
          presenterWindow = window.open(popupUrl, '_blank', 'popup,width=1120,height=820,resizable=yes,scrollbars=yes');
          if (!presenterWindow) throw new Error('popup blocked');
          presenterWindow.focus();
          setPresenterStatus('Presenter view opened in a separate window.');
          broadcastPresenterState();
        } catch {
          cleanupPresenter(false);
          presenterStandalone?.removeAttribute('hidden');
          setPresenterStatus('Presenter view could not be opened or connected. Open standalone notes in a new tab.');
          return;
        }
      } else {
        presenterWindow = window.open(`${window.location.origin}${presenterUrl}${presenterFragment({ mode: presenterMode, slide: current })}`, '_blank', 'popup,width=1120,height=820,resizable=yes,scrollbars=yes');
        if (!presenterWindow) {
          presenterStandalone?.removeAttribute('hidden');
          setPresenterStatus('Presenter view is available in a new tab.');
          return;
        }
        presenterWindow.focus();
        setPresenterStatus('Presenter view opened in standalone mode.');
      }
      presenterWindowWatch = window.setInterval(() => {
        if (presenterWindow?.closed) {
          cleanupPresenter(false);
          setPresenterStatus('Presenter view closed.');
        } else if (presenterChannel && presenterSession && Date.now() - presenterHeartbeatAt >= 2000) {
          broadcastPresenterState('heartbeat');
        }
      }, 1000);
    }

    const fitWebStage = () => {
      const activeStage = viewer.querySelector<HTMLElement>('.lecture-slide[data-current] .web-stage');
      const content = activeStage?.querySelector<HTMLElement>('.web-stage-content');
      const inFullscreen = document.fullscreenElement === viewer || viewer.classList.contains('is-fullscreen-fallback');
      if (!activeStage || !content || !inFullscreen || window.innerWidth <= 640) {
        content?.style.removeProperty('--web-fit');
        return;
      }
      requestAnimationFrame(() => {
        if (!content.isConnected || !(document.fullscreenElement === viewer || viewer.classList.contains('is-fullscreen-fallback'))) return;
        content.style.removeProperty('--web-fit');
        const stageStyle = window.getComputedStyle(activeStage);
        const availableWidth = activeStage.clientWidth - Number.parseFloat(stageStyle.paddingLeft) - Number.parseFloat(stageStyle.paddingRight);
        const availableHeight = activeStage.clientHeight - Number.parseFloat(stageStyle.paddingTop) - Number.parseFloat(stageStyle.paddingBottom);
        const widthRatio = content.scrollWidth > 0 ? availableWidth / content.scrollWidth : 1;
        const heightRatio = content.scrollHeight > 0 ? availableHeight / content.scrollHeight : 1;
        const fit = Math.min(1, widthRatio, heightRatio);
        content.style.setProperty('--web-fit', String(Math.max(0.01, fit)));
      });
    };

    const slideFromHash = () => {
      const match = window.location.hash.match(/^#slide-(\d+)$/);
      const value = match ? Number(match[1]) : 1;
      return Number.isInteger(value) && value >= 1 && value <= total ? value : 1;
    };

    const setSlide = (value: number, push = false) => {
      const bounded = Math.max(1, Math.min(total, value));
      const changed = bounded !== current;
      const outgoingSlide = slides.find((slide) => Number(slide.dataset.slide) === current);
      const focusSlide = outgoingSlide?.contains(document.activeElement) ?? false;
      current = bounded;
      slides.forEach((slide) => {
        const active = Number(slide.dataset.slide) === current;
        slide.toggleAttribute('data-current', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      numberLabel && (numberLabel.textContent = String(current));
      announcement && (announcement.textContent = `Slide ${current} of ${total}`);
      if (previous) previous.disabled = current <= 1;
      if (next) next.disabled = current >= total;
      const url = new URL(window.location.href);
      url.hash = `slide-${current}`;
      if (push && changed) window.history.pushState({}, '', url);
      else if (window.location.hash !== `#slide-${current}`) window.history.replaceState({}, '', url);
      fitWebStage();
      updateStandaloneLink();
      broadcastPresenterState();
      if (focusSlide && changed) slides.find((slide) => Number(slide.dataset.slide) === current)?.focus({ preventScroll: true });
    };

    const move = (delta: number) => {
      const target = Math.max(1, Math.min(total, current + delta));
      if (target !== current) setSlide(target, true);
    };
    const editableTarget = (target: EventTarget | null) => target instanceof HTMLElement && Boolean(target.closest('input,textarea,select,[contenteditable="true"]'));
    const ownsSpace = (target: EventTarget | null) => target instanceof HTMLElement && Boolean(target.closest('a,button,summary'));

    viewer.classList.add('js-enabled');
    setSlide(slideFromHash());
    previous?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    presenterButton?.addEventListener('click', openPresenter);
    window.addEventListener('hashchange', () => setSlide(slideFromHash()));
    window.addEventListener('popstate', () => setSlide(slideFromHash()));
    window.addEventListener('pagehide', () => cleanupPresenter(true));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && viewer.classList.contains('is-fullscreen-fallback')) {
        viewer.classList.remove('is-fullscreen-fallback');
        updateFullscreenLabel();
        return;
      }
      if (event.ctrlKey || event.metaKey || event.altKey || editableTarget(event.target) || (event.key === ' ' && ownsSpace(event.target))) return;
      if (event.key === 'ArrowLeft' || event.key === 'PageUp' || (event.key === ' ' && event.shiftKey)) {
        event.preventDefault();
        move(-1);
      } else if (event.key === 'ArrowRight' || event.key === 'PageDown' || (event.key === ' ' && !event.shiftKey)) {
        event.preventDefault();
        move(1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        setSlide(1, true);
      } else if (event.key === 'End') {
        event.preventDefault();
        setSlide(total, true);
      }
    });

    const updateFullscreenLabel = () => {
      const active = document.fullscreenElement === viewer || viewer.classList.contains('is-fullscreen-fallback');
      fullscreen?.setAttribute('aria-pressed', String(active));
      fullscreen?.setAttribute('aria-label', active ? 'Exit fullscreen' : 'Enter fullscreen');
      fullscreen?.setAttribute('title', active ? 'Exit fullscreen' : 'Enter fullscreen');
      fullscreenLabel && (fullscreenLabel.textContent = active ? 'Exit fullscreen' : 'Fullscreen');
      fitWebStage();
    };

    fullscreen?.addEventListener('click', async () => {
      if (document.fullscreenElement === viewer) {
        await document.exitFullscreen?.();
      } else if (viewer.classList.contains('is-fullscreen-fallback')) {
        viewer.classList.remove('is-fullscreen-fallback');
      } else if (viewer.requestFullscreen) {
        try {
          await viewer.requestFullscreen();
        } catch {
          viewer.classList.add('is-fullscreen-fallback');
        }
      } else {
        viewer.classList.add('is-fullscreen-fallback');
      }
      updateFullscreenLabel();
    });
    document.addEventListener('fullscreenchange', updateFullscreenLabel);
    window.addEventListener('resize', fitWebStage);
  }
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The requested page could not be found." canonicalPath="/404.html" noindex>
  <article class="page-shell">
    <header class="page-header">
      <p class="eyebrow">404 / NOT FOUND</p>
      <h1 class="page-title">That page moved.</h1>
      <p class="page-intro">Try the writing archive or return to the home page.</p>
    </header>
    <p class="topic-nav"><a href="/">← Home</a><a href="/archives.html">Browse writing</a></p>
  </article>
</BaseLayout>

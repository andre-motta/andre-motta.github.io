---
import profile from '../data/profile.json';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Author" description={`Writing by ${profile.name}.`} canonicalPath="/authors.html">
  <article class="page-shell">
    <header class="page-header">
      <p class="eyebrow">ANDRE LUSTOSA / AUTHOR</p>
      <h1 class="page-title">One voice, many systems.</h1>
      <p class="page-intro">All writing on this site is by {profile.name}, a {profile.role} at {profile.organization}.</p>
    </header>
    <p class="topic-nav"><a href="/archives.html">Browse all writing →</a></p>
  </article>
</BaseLayout>
